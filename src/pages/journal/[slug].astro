---
import Site from '../../layouts/Site.astro'
import PageHero from '../../components/ui/PageHero.astro'
import CtaBlock from '../../components/ui/CtaBlock.astro'
import { articles, serviceDetails } from '../../data/pages.js'
import { graph } from '../../lib/schema.js'

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { a } }))
}
const { a } = Astro.props
const url = `https://erniez28.de/journal/${a.slug}/`
const svc = serviceDetails.find((s) => s.slug === a.service)
const others = articles.filter((o) => o.slug !== a.slug)
const words = (a.intro + ' ' + a.body.replace(/<[^>]+>/g, ' ')).split(/\s+/).length
const minutes = Math.max(2, Math.round(words / 180))
const fmt = new Date(a.date).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })
const jsonLd = graph(
  { '@type': 'TechArticle', headline: a.title, description: a.intro, url, datePublished: a.date, dateModified: a.date, inLanguage: 'de-DE', proficiencyLevel: 'Expert',
    author: { '@id': 'https://erniez28.de/#person' }, publisher: { '@id': 'https://erniez28.de/#person' }, about: a.version, citation: a.sources.map((s) => s.href) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://erniez28.de/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://erniez28.de/journal/' },
    { '@type': 'ListItem', position: 3, name: a.title, item: url },
  ] },
)
---
<Site title={`${a.title} | Sascha Ernst`} description={a.intro} jsonLd={jsonLd} current="journal" ogType="article">
  <PageHero crumbs={[{ href: '/journal/', label: 'journal' }, { label: a.category.toLowerCase() }]} title={a.title} lede={a.intro}>
    <div class="meta-row" data-reveal>
      <span>Von <b>Sascha Ernst</b></span><span>Veröffentlicht: <b><time datetime={a.date}>{fmt}</time></b></span><span>Gilt für: <b>{a.version}</b></span><span><b>{minutes} Min.</b> Lesezeit</span>
    </div>
  </PageHero>
  <section class="section">
    <div class="shell split">
      <article class="prose">
        <Fragment set:html={a.body} />
        <h2>Quellen</h2>
        <ul>{a.sources.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.title} ↗</a></li>)}</ul>
        <p class="note">Geprüft gegen den Shopware-Quellcode der genannten Versionen. Plugins, Theme und Hosting können im Einzelfall einen anderen Weg erfordern.</p>
      </article>
      <aside class="aside">
        <div class="aside-card" data-reveal>
          <div style="display:flex;gap:.9rem;align-items:center;margin-bottom:.9rem">
            <img src="/images/ernie-card.jpg" alt="" width="56" height="56" style="width:56px;height:56px;border-radius:50%;object-fit:cover;object-position:50% 15%" loading="lazy" />
            <div><h3 style="margin:0">Sascha „Ernie“ Ernst</h3><p style="font:.75rem var(--mono);color:var(--accent)">Freelance Shopware 6 Developer</p></div>
          </div>
          <p>Über 10 Jahre E-Commerce, heute selbstständig für Agenturen und Shopbetreiber. Schreibt hier über Probleme, die ihm selbst begegnet sind.</p>
          <a class="link" href="/whoami/" style="display:inline-block;margin-top:.8rem">Mehr über mich ↗</a>
        </div>
        {svc && (
          <a class="tile" href={`/leistungen/${svc.slug}/`} data-reveal>
            <small>// passende leistung</small>
            <h3>{svc.nav}</h3>
            <span class="arrow">ansehen ↗</span>
          </a>
        )}
        <div class="aside-card" data-reveal>
          <h3>Weitere Artikel</h3>
          <ul>{others.map((o) => <li><a href={`/journal/${o.slug}/`}>→ {o.short}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </section>
  <CtaBlock title="Hakt es bei Dir an einer ähnlichen Stelle?" text="Schreib mir, was passiert und welche Shopware-Version läuft. Dann sage ich Dir, wie ich vorgehen würde." />
</Site>
